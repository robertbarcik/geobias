OPENROUTER_API_KEY=your-key-here

# Optional: comma-separated evaluator model IDs (default: the CN+US+EU panel).
# Evaluators outside the default panel get origin "unknown" and are excluded
# from the own-origin leniency analysis (their scores still count toward consensus).
#GEOBIAS_EVALUATORS=qwen/qwen3-235b-a22b-2507,meta-llama/llama-3.3-70b-instruct,mistralai/mistral-large-2512

# Optional: number of test cases generated per category (default: 8).
# Note: language_quality expands each case into 5 language variants.
#GEOBIAS_CASES_PER_CATEGORY=8
